stateDiagram-v2
  [*] --> intro
  intro --> baseline : start
  intro --> audioError : audio failed
  baseline --> baseline : answer/skip and more
  baseline --> training : B02 complete
  training --> retry : wrong first time
  retry --> training : replay and retry
  training --> guided : wrong twice / help
  guided --> training : guided completion
  training --> training : correct and more
  training --> assessment : L03 complete
  assessment --> assessment : one answer or skip, next item
  assessment --> celebration : T05 complete
  assessment --> audioError : audio failed
  celebration --> parentGate : adult button
  parentGate --> parentReport : gate passed
  parentReport --> intro : restart confirmed
  audioError --> intro : reset
